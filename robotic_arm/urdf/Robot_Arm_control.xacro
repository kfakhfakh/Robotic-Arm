<?xml version="1.0"?>
<robot name="robotic_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="RobotSystem" type="system">
        <xacro:if value="${use_ignition}">    
            <hardware>
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </hardware>
        </xacro:if>
        <xacro:unless value="${use_ignition}">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
        </xacro:unless>
        <joint name="base_waist_joint">
            <command_interface name="position">
                <param name="min">-3.142/2</param>
                <param name="max">3.142/2</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="waist_arm_joint">
            <command_interface name="position">
                <param name="min">-3.142/2</param>
                <param name="max">3.142/2</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
        <joint name="arm_end_joint">
            <command_interface name="position">
                <param name="min">-3.142/2</param>
                <param name="max">3.142/2</param>
            </command_interface>
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>
</robot>