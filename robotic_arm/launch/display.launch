<launch>
    <let name="urdf_path" value="$(find-pkg-share robotic_arm)/urdf/Robot_Arm.xacro" />
    <let name="rviz_path" value="$(find-pkg-share robotic_arm)/rviz/rviz_config.rviz" />

    <!-- Robot State Publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    </node>
    <!-- Joint State Publisher GUI -->
    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"/>
    <!-- RViz2 -->
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_path)"/>
</launch>